.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Local model weights and third-party CT-CLIP checkout.
models/
external/

# CT-RATE, RadGenome, uploads, and temporary dependency caches stay local.
# The small, source-attributed medical knowledge corpus is intentionally tracked.
data/*
!data/knowledge/
!data/knowledge/**
dataset/
.deps/
.remote_assets/

# Generated artifacts remain local by default. These project-trained inference
# assets are intentionally versioned by the upstream repository for reproducibility.
artifacts/*
!artifacts/text_classifier.joblib
!artifacts/llm_qlora/
artifacts/llm_qlora/*
!artifacts/llm_qlora/qwen3_5_9b_evidence_json_1ep_single/
!artifacts/llm_qlora/qwen3_5_9b_evidence_json_1ep_single/adapter/
