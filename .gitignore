!artifacts/llm_qlora/qwen3_5_9b_evidence_json_1ep_single/adapter/training_args.bin
!artifacts/llm_qlora/qwen3_5_9b_ctclip_stage2_500_2ep/
!artifacts/llm_qlora/qwen3_5_9b_ctclip_stage2_500_2ep/adapter/
