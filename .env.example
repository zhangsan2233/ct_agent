AGENT_MODEL=Qwen/Qwen3.6-35B-A3B
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_BACKEND=hybrid-local
EMBEDDING_MODEL_PATH=./models/qwen/Qwen3-Embedding-0.6B
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_MODEL_PATH=./models/qwen/Qwen3-Reranker-0.6B
LOCAL_RAG_DEVICE=cpu
RAG_DENSE_CANDIDATES=30
RAG_BM25_CANDIDATES=30
RAG_RERANK_CANDIDATES=20
RAG_RERANKER_MAX_LENGTH=256
QDRANT_PATH=./artifacts/qdrant
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=10
MODEL_BACKEND=openai-compatible
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
OPENAI_COMPATIBLE_API_KEY=replace-me
# To run the locally fine-tuned Stage-2 QLoRA model, set MODEL_BACKEND=local-qlora.
# The model and adapter are loaded only at the first LLM request; no download is attempted.
LOCAL_LLM_MODEL_DIR=./models/qwen3_5_9B/Qwen3.5-9B
LOCAL_LLM_ADAPTER_DIR=./artifacts/llm_qlora/qwen3_5_9b_ctclip_stage2_500_2ep/adapter
LOCAL_LLM_DEVICE=auto
LOCAL_LLM_LOAD_IN_4BIT=true
REQUEST_TIMEOUT_SECONDS=45
LLM_JSON_MAX_TOKENS=1024
LLM_TEXT_MAX_TOKENS=512
LLM_REASONING_EFFORT=auto
HF_TOKEN=
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
ARTIFACT_DIR=./artifacts
STATIC_DIR=./static
CT_MODEL_BACKEND=ct-clip
CTCLIP_VARIANT=zeroshot
CTCLIP_CHECKPOINT=./models/ctclip/CT-CLIP_v2.pt
CTCLIP_SOURCE_DIR=./external/CT-CLIP-main
CTCLIP_PYTHON=
CTCLIP_DEVICE=auto
CTCLIP_USE_FP16=true
CTCLIP_TIMEOUT_SECONDS=600
CT_CACHE_ENABLED=true
CT_MAX_POSITIVE_LABELS=11
KNOWLEDGE_DIR=./data/knowledge
CALIBRATION_PATH=./artifacts/calibration/calibrators.joblib
RADGRAPH_ENABLED=true
RADGRAPH_MODEL_TYPE=modern-radgraph-xl
RADGRAPH_MODEL_CACHE_DIR=./models/radgraph
RADGRAPH_TOKENIZER_CACHE_DIR=./models/huggingface
RADGRAPH_TIMEOUT_SECONDS=180
RADGENOME_MASK_DIR=./data/radgenome
RADGENOME_INDEX_PATH=./artifacts/radgenome/mask_index.csv
RADGENOME_MAX_MASKS=8
MEMORY_DB_PATH=./artifacts/memory/agent_memory.sqlite3
AGENT_DYNAMIC_PLANNING=true
TOOL_MAX_RETRIES=1
TOP_K_SIMILAR=5
RAG_MAX_ATTEMPTS=2
MIN_LABEL_CONFIDENCE=0.35
POSITIVE_LABEL_THRESHOLD=0.5
STRONG_NEGATIVE_THRESHOLD=0.15
DISCLAIMER=仅用于课程设计和科研演示，不作为临床诊断依据。
