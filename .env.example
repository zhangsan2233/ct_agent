AGENT_MODEL=Qwen/Qwen3.6-35B-A3B
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
MODEL_BACKEND=openai-compatible
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
OPENAI_COMPATIBLE_API_KEY=replace-me
HF_TOKEN=
DATA_DIR=./data
ARTIFACT_DIR=./artifacts
STATIC_DIR=./static
CT_MODEL_BACKEND=ct-clip
CTCLIP_CHECKPOINT=./models/ctclip/CT-CLIP_v2.pt
CTCLIP_SOURCE_DIR=./external/CT-CLIP-main
CTCLIP_PYTHON=
CTCLIP_DEVICE=auto
CTCLIP_USE_FP16=true
CTCLIP_TIMEOUT_SECONDS=600
TOP_K_SIMILAR=5
MIN_LABEL_CONFIDENCE=0.35
DISCLAIMER=仅用于课程设计和科研演示，不作为临床诊断依据。
