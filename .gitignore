# binary patterns above. The two safetensors files are tracked by Git LFS.
!artifacts/text_classifier.joblib
!artifacts/llm_qlora/qwen3_5_9b_evidence_json_1ep_single/adapter/adapter_model.safetensors
!artifacts/llm_qlora/qwen3_5_9b_evidence_json_1ep_single/adapter/adapter_config.json
!artifacts/llm_qlora/qwen3_5_9b_evidence_json_1ep_single/adapter/training_args.bin
