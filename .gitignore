.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Local model weights and third-party CT-CLIP checkout.
models/
external/

# CT-RATE downloads, NIfTI volumes, temporary dependency caches, and all
# generated inference/training/evaluation outputs must remain local.
data/
dataset/
# Generated artifacts remain local by default. The exact three project-trained
# inference assets below are intentionally versioned for reproducibility.
artifacts/*
!artifacts/text_classifier.joblib
!artifacts/llm_qlora/
artifacts/llm_qlora/*
!artifacts/llm_qlora/qwen3_5_9b_evidence_json_1ep_single/
!artifacts/llm_qlora/qwen3_5_9b_evidence_json_1ep_single/adapter/
!artifacts/llm_qlora/qwen3_5_9b_evidence_json_1ep_single/adapter/adapter_model.safetensors
